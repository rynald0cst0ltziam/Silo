{
  "crons": [
    {
      "path": "/api/cron/warmup",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/daily-warmup",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/reset-events",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
