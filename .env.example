# Public site origin, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Neon Postgres — connection string with pooler (used by Prisma Client at runtime).
DATABASE_URL=

# Neon Postgres — direct connection (used by Prisma Migrate only).
DIRECT_URL=

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs — create in Stripe Dashboard (Products → each plan → copy price ID)
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_ANNUAL=
STRIPE_PRICE_PORTFOLIO_MONTHLY=
STRIPE_PRICE_PORTFOLIO_ANNUAL=

# Vercel Cron secret — set in Vercel Dashboard (Settings → Environment Variables)
CRON_SECRET=

# Optional privacy-friendly analytics. Leave blank to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional PostHog alternative. The site ships with Plausible; swap the component if needed.
NEXT_PUBLIC_POSTHOG_KEY=
