# Public site origin, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Neon Postgres — connection string with pooler (used by Prisma Client at runtime).
DATABASE_URL=

# Neon Postgres — direct connection (used by Prisma Migrate only).
DIRECT_URL=

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Stripe billing (Phase 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional privacy-friendly analytics. Leave blank to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional PostHog alternative. The site ships with Plausible; swap the component if needed.
NEXT_PUBLIC_POSTHOG_KEY=
